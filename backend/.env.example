PORT=5000
# Put the database name at the end of the URI (/marinaut); otherwise data goes to the "test" database
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/marinaut?appName=Cluster0
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

# Required to register from the Admin portal (if empty, admin registration is disabled)
ADMIN_REGISTRATION_KEY=change_me_admin_key

# ---------- Optional ----------
CLIENT_URL=http://localhost:5173

# Days allowed to pay a fine (payment time limit)
FINE_DUE_DAYS=30
# After the due date, % of the base amount added every period
LATE_FEE_PERCENT=5
# Same, for repeat offences
REPEAT_LATE_FEE_PERCENT=10
# Length of one late-fee period in days
LATE_FEE_INTERVAL_DAYS=30

# A SEPARATE database for `npm test` (it is wiped at the start of every test run!)
MONGO_URI_TEST=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/marinaut_test?appName=Cluster0